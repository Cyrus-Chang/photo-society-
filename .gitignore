# ===== 依赖与构建产物 =====
node_modules/
dist/
.vite/
*.log

# ===== 本地密钥（只走环境变量，绝不入库）=====
.env
.env.*
!.env.example

# ===== Python 运行时（体积大、可重建）=====
ai-classifier/.venv/
.venv/
__pycache__/
*.pyc

# ===== AI 训练数据与外部数据集（许可不齐，不入库）=====
ai-classifier/data/*
!ai-classifier/data/
!ai-classifier/data/retrieval_labels.json
ai-classifier/external/
ai-classifier/cache/
ai-classifier/reports/
*.parquet

# ===== 非交付物：调试夹具、截图、参考 demo、用户素材、归档 =====
.spiral-ref/
.screenshots/
.review-tmp/
.trae-html-share-packages/
素材/
归档_旧版稿/
*.tmp
.mis.txt

# ===== 并行会话的临时脚手架（含 Chrome profile，8k+ 文件，绝不入库）=====
.staging/

# ===== AI 服务运行日志（每次请求都在长，不入库）=====
ai-classifier/logs/

# ===== 系统与编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ===== pip 在仓库根目录留下的临时解包目录（2026-11-17 实测 51 个 / 87.8MB）=====
pip-unpack-*/
pip-install-*/
pip-build-tracker-*/
pip-ephem-wheel-cache-*/
pip-metadata-*/
pip-target-*/

# ===== 训练用独立 venv 与模型权重（可重建，体积 3GB 起，绝不入库）=====
# 注意：不要写成 models/，那会连 ai-classifier/models/ 一起忽略掉（那里是要入库的索引产物）
.staging/.venv-train/
*.safetensors
*.gguf

