# ============================================================
# 拍社 PHOTO SOCIETY · 环境变量模板
# ------------------------------------------------------------
# 用法：复制为 .env（前端）或在启动 AI 服务前按需导出；
#       .env 已被 .gitignore 排除，不要提交任何真实密钥。
#   本仓库不含任何密钥，以下值全部为空或为本地默认值。
# ============================================================

# ---------- 前端（Vite，构建期注入）----------
# 业务接口前缀。默认 /api/v1，由 vite.config.ts 代理到 8100 的 AI/BFF 服务。
VITE_API_BASE_URL=/api/v1

# ---------- AI 服务（8100，FastAPI）----------
# 模型服务地址：MCP server 与前端 BFF 转发时读取。
AI_SERVICE_URL=http://127.0.0.1:8100

# 离线模式：模型与 CLIP 权重已缓存到本地时打开，避免启动时联网拉取。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# CLIP 视觉塔（图像向量与风格识别共用）。
CLIP_MODEL=openai/clip-vit-base-patch32

# 作品向量索引目录，相对 ai-classifier/；仓库内已带索引产物。
MODEL_DIR=models

# 风格/影调分类阈值：低于 MIN_CONF 视为不确定，低于 REVIEW_CONF 转人工。
MIN_CONF=0.30
REVIEW_CONF=0.55
SUBJECT_GATE_CONF=0.78
SUBJECT_PERSON_MASS_MAX=0.45

# 标签字典与安全规则文件（相对 ai-classifier/）。
DICT_PATH=labels/dictionary.json
SAFETY_CONFIG=config/safety.json
# 安全审计日志落盘路径；留空则只写内存。
SAFETY_AUDIT_LOG=

# ---------- 本地对话模型（Qwen2.5-1.5B + LoRA）----------
# 指向训练产出的合并模型目录；仓库不含权重，留空则对话走 mode=fallback 模板。
# 例：CHAT_MODEL_DIR=E:\通用型摄影师接单平台\.staging\models\paishe-chat-merged
CHAT_MODEL_DIR=

# 推理设备与采样参数。torch 必须是 CUDA 版，否则退化为 12–20 秒/句。
CHAT_DEVICE=cuda
CHAT_TEMPERATURE=0.7
CHAT_MAX_NEW_TOKENS=96

# ---------- 可选：外部 LLM（当前未启用）----------
# 项目未接入大模型 API。三者留空时，文案接口固定返回 mode=rule 模板兜底。
# 如需接入，自行填入，并确保不要把真实值写进仓库。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SEC=20
LLM_RETRIES=2

# ---------- MCP server（可选）----------
# 默认关闭鉴权与限流；对公网暴露前请务必开启。
MCP_AUTH_TOKEN=
MCP_RATE_LIMIT_PER_MINUTE=0
